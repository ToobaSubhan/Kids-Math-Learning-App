<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F5F5">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="My Weak Spots 🧠"
            android:textSize="28sp"
            android:textStyle="bold"
            android:textColor="#333333"
            android:layout_marginBottom="8dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Practice these questions to get stronger!"
            android:textSize="14sp"
            android:textColor="#666666"
            android:layout_marginBottom="24dp"/>

        <!-- Addition -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Addition"
            android:textStyle="bold"
            android:textColor="#4CAF50"/>
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvWeakAddition"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:nestedScrollingEnabled="false" />
        <TextView
            android:id="@+id/tvEmpty+"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="16dp"
            android:text="No data yet. Play more!"
            android:visibility="gone"/>

        <!-- Subtraction -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Subtraction"
            android:textStyle="bold"
            android:textColor="#2196F3"/>
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvWeakSubtraction"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:nestedScrollingEnabled="false" />
        <TextView
            android:id="@+id/tvEmpty-"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="16dp"
            android:text="No data yet. Play more!"
            android:visibility="gone"/>

        <!-- Multiplication -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Multiplication"
            android:textStyle="bold"
            android:textColor="#FF9800"/>
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvWeakMultiplication"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:nestedScrollingEnabled="false" />
        <TextView
            android:id="@+id/tvEmpty*"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="16dp"
            android:text="No data yet. Play more!"
            android:visibility="gone"/>

        <!-- Division -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Division"
            android:textStyle="bold"
            android:textColor="#9C27B0"/>
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvWeakDivision"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:nestedScrollingEnabled="false" />
        <TextView
            android:id="@+id/tvEmpty/"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="16dp"
            android:text="No data yet. Play more!"
            android:visibility="gone"/>

        <Button
            android:id="@+id/btnBack"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_marginTop="32dp"
            android:text="Back to Menu"
            android:backgroundTint="#333333"/>

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
